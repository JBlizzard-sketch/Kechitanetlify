{
  "name": "kechita-capital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . || true",
    "test": "jest --runInBand --detectOpenHandles || true",
    "demo": "node scripts/demo_end_to_end.js",
    "worker": "node workers/mpesaWorker.js",
    "start:dev": "next start -p 3000",
    "migrate": "psql $DATABASE_URL -f migrations/001_create_tables.sql && psql $DATABASE_URL -f migrations/002_add_unique_constraint_payments.sql",
    "e2e": "npx playwright test",
    "build:staging": "NODE_ENV=staging npm run build",
    "sitemap": "node scripts/generate_sitemap.js",
    "postbuild": "npm run sitemap || true",
    "lint:a11y": "npx playwright test e2e/accessibility.spec.ts || true",
    "format": "prettier --write . || true",
    "worker:scoring": "node workers/scoringWorker.js",
    "copilot:test": "node ./scripts/run_copilot_test.sh || true",
    "test:unit": "jest --runInBand || true",
    "start:staging": "next start -p 3000",
    "ci:test": "npm run test"
  },
  "dependencies": {
    "next": "14.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "framer-motion": "^10.12.8",
    "tailwindcss": "^4.0.0",
    "@fontsource/inter": "^4.5.10",
    "pg": "^8.11.0",
    "ioredis": "^5.3.2",
    "bullmq": "^1.80.0",
    "@supabase/supabase-js": "^2.27.0",
    "node-fetch": "^3.4.0",
    "formidable": "^3.5.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.0.0",
    "dotenv": "^16.0.0",
    "@sentry/node": "^8.0.0"
  },
  "devDependencies": {
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "8.45.0",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/jest": "^29.5.3",
    "playwright": "^1.40.0",
    "@axe-core/playwright": "^4.2.0"
  },
  "engines": {
    "node": "18.x"
  }
}
